#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/workspace/agent/node_modules/.pnpm/node-jq@6.3.1/node_modules/node-jq/node_modules:/workspace/agent/node_modules/.pnpm/node-jq@6.3.1/node_modules:/workspace/agent/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/workspace/agent/node_modules/.pnpm/node-jq@6.3.1/node_modules/node-jq/node_modules:/workspace/agent/node_modules/.pnpm/node-jq@6.3.1/node_modules:/workspace/agent/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../node-jq" "$@"
else
  exec node  "$basedir/../../node-jq" "$@"
fi
